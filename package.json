{
  "name": "queueue",
  "version": "0.1.0",
  "private": true,
  "description": "A shared mosaic for you and your friends, peer to peer",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "spike": "node spike/replicate.mjs",
    "spike:electron": "electron spike/electron-check.cjs",
    "dist": "electron-vite build && electron-builder --mac --arm64"
  },
  "build": {
    "appId": "guide.queueue.app",
    "productName": "queueue",
    "directories": { "output": "dist" },
    "files": ["out/**/*", "package.json"],
    "asarUnpack": ["**/*.node", "**/prebuilds/**"],
    "protocols": [{ "name": "queueue invite", "schemes": ["queueue"] }],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": ["dmg", "zip"],
      "identity": null
    }
  },
  "dependencies": {
    "b4a": "^1.9.0",
    "compact-encoding": "^3.5.2",
    "corestore": "^7.12.6",
    "exifr": "^7.1.3",
    "hypercore": "^11.37.0",
    "hypercore-crypto": "^3.7.0",
    "hyperdrive": "^13.3.4",
    "hyperswarm": "^4.17.2",
    "music-metadata": "^11.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
